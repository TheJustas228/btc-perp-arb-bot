# Copy this file to .env and fill in real values.
# Never commit the resulting .env (it is ignored by .gitignore).

# Live MEXC futures keys (read-only scope today; flip "Order Placing" on
# only after strategy fixes + KYC + small-capital validation).
MEXC_API_KEY=
MEXC_API_SECRET=

# MEXC USDT-M futures taker fee used in edge math (fraction: 0.0001 = 0.01%).
# Defaults to 0.0001 if unset. Demo/paper UI often shows 0.02% — then set:
# MEXC_FUTURES_TAKER_FEE=0.0002

# Live Bitfinex master keys (read-only: fee tier, account info, funding rates).
BITFINEX_API_KEY=
BITFINEX_API_SECRET=

# Bitfinex paper trading subaccount keys (separate subaccount, not the master).
# Used for execution-path validation against tTESTBTCF0:TESTUSDTF0.
BITFINEX_API_KEY_PAPER=
BITFINEX_API_SECRET_PAPER=

# Optional: Binance Futures Testnet keys (https://testnet.binancefuture.com).
# Useful as a USDT-M paper venue because MEXC has no public API testnet.
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# Top-level kill switch. Must be exactly "true" before any code is allowed
# to place a real (non-paper) order.
ARB_LIVE_TRADING=false

# Modeled entry edge floor (USD at execution size). Winners in early logs were >= ~2.2;
# default is 2.55 if unset. Disable extra floor with MIN_ENTRY_ESTIMATED_NET=0
# MIN_ENTRY_ESTIMATED_NET=2.80

# Maximum modeled one-side entry fees (USD). Helps avoid high-fee regimes that
# historically produced mostly losers in this strategy. Default: 0.35 if unset.
# Disable with MAX_ENTRY_FEES_USD=0
# MAX_ENTRY_FEES_USD=0.35

# Optional comma-separated routes (exact "Buy Name->Sell Name" as in closed trades).
# Example — only MEXC buy / Bitfinex sell:
# ALLOW_ROUTES_ONLY=MEXC Futures->Bitfinex Derivatives
